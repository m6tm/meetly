generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Meeting {
  id          String              @id @default(uuid())
  name        String
  date        DateTime
  code        String              @unique
  accessKey   String?
  time        String
  kind        MeetingKind         @default(SCHEDULE)
  isRecurring Boolean             @default(false)
  egressId    String?
  cancelled   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  userId      String              @db.Uuid
  invitees    MeetingInvitation[]

  meetingRecordings MeetingRecording[]
  meetingSessions   MeetingSession[]

  @@map("meeting")
}

model MeetingSession {
  id        String    @id @default(uuid())
  meetingId String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("meeting_session")
}

model MeetingInvitation {
  id        String                  @id @default(uuid())
  role      MeetingRole             @default(participant)
  email     String
  status    MeetingInvitationStatus @default(Waiting)
  userId    String?                 @db.Uuid
  meetingId String

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("meeting_invitation")
}

model MeetingRecording {
  id                   String                     @id @default(uuid())
  meetingId            String
  name                 String                     @unique
  egressId             String                     @unique
  recording_status     MeetingRecordingStatus     @default(RECORDING_IN_PROGRESS)
  transcription_status MeetingTranscriptionStatus @default(TRANSCRIPTION_PENDING)
  recordDate           DateTime
  transcription        String?
  summary              String?
  deleted              Boolean                    @default(false)

  meeting              Meeting               @relation(fields: [meetingId], references: [id])
  meetingRecordingPath MeetingRecordingPath?

  @@map("meeting_recording")
}

model MeetingRecordingPath {
  id                 String    @id @default(uuid())
  meetingRecordingId String    @unique
  saveDate           DateTime?
  createdAt          DateTime
  filename           String
  filepath           String
  duration           String    @default("0")

  meetRecording MeetingRecording @relation(fields: [meetingRecordingId], references: [id])

  @@map("meeting_recording_path")
}

enum MeetingInvitationStatus {
  Cancelled
  Accepted
  Waiting
}

enum MeetingRecordingStatus {
  RECORDING_COMPLETED
  RECORDING_IN_PROGRESS
  RECORDING_SAVED
  RECORDING_FAILLED
}

enum MeetingTranscriptionStatus {
  TRANSCRIPTION_PENDING
  TRANSCRIPTION_IN_PROGRESS
  TRANSCRIPTION_COMPLETED
  TRANSCRIPTION_FAILLED
}

enum TeamMemberRole {
  ADMIN
  EDITOR
  VIEWER
  MEMBER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamMemberStatus {
  ACTIVE
  INVITED
  INACTIVE
}

model Team {
  id          String           @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String           @db.Uuid
  members     TeamMember[]
  invitations TeamInvitation[]

  @@map("team")
}

model TeamMember {
  id        String           @id @default(uuid())
  teamId    String
  userId    String           @db.Uuid
  role      TeamMemberRole   @default(MEMBER)
  status    TeamMemberStatus @default(INVITED)
  joinedAt  DateTime?
  updatedAt DateTime         @updatedAt
  lastLogin DateTime?

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
  @@map("team_member")
}

model TeamInvitation {
  id        String               @id @default(uuid())
  teamId    String
  email     String
  role      TeamMemberRole       @default(MEMBER)
  token     String               @unique
  expiresAt DateTime
  status    TeamInvitationStatus @default(PENDING)
  invitedBy String               @db.Uuid
  invitedAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  userId String? @db.Uuid

  @@map("team_invitation")
}

model Account {
  id        String        @id @default(uuid())
  status    AccountStatus @default(INACTIVE)
  userId    String        @unique @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("account")
}

model Appearance {
  id        String   @id @default(uuid())
  userId    String   @unique @db.Uuid
  theme     Theme    @default(SYSTEM)
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appearance")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @unique @db.Uuid
  type      NotificationType
  content   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification")
}

model NotificationPreference {
  id        String           @id @default(uuid())
  userId    String           @db.Uuid
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification_preference")
}

enum NotificationType {
  MEETING_REMINDER
  TRANSCRIPTION_UPDATE
  NEWS_UPDATE
  TEAM_ACTIVITY
  SECURITY_ALERT
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSE_REQUESTED
  CLOSED
}

enum MeetingKind {
  INSTANT
  SCHEDULE
}

enum MeetingRole {
  admin
  moderator
  participant
}
